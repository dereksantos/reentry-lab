// Cloudflare Workers config for the hosted version of Reentry Lab. See DEPLOY.md.
// Secrets (never put them here): SESSION_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET.
// Set them with `npx wrangler secret put NAME`; for `wrangler dev`, put them in .dev.vars (git-ignored).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reentry-lab",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request goes through the Worker first, so it can redirect http, www and workers.dev to https://CANONICAL_HOST.
    "run_worker_first": true
  },
  // Keep the workers.dev address alive so old links redirect to the custom domain; no per-version preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "reentrylab.ai", "custom_domain": true },
    { "pattern": "www.reentrylab.ai", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [{ "name": "LAB", "class_name": "Lab" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lab"] }],
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "4101", "simple": { "limit": 120, "period": 60 } },
    { "name": "FETCH_LIMIT", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } },
    { "name": "AUTH_LIMIT", "namespace_id": "4103", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    // The app's one public address. Requests to www.<this> or *.workers.dev are redirected here; localhost is left alone.
    "CANONICAL_HOST": "reentrylab.ai",
    // Shown as "Support this project" in the app when set (the project's Ko-fi page). Empty hides the button.
    "SUPPORT_URL": "",
    // Link to the public source repository, shown in Settings when set.
    "SOURCE_URL": "https://github.com/dereksantos/reentry-lab"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
